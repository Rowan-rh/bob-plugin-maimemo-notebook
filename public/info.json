{
  "identifier": "cc.chriscurry.bobplugin.maimemo.notebook",
  "version": "0.4.0",
  "category": "translate",
  "name": "墨墨云词本",
  "summary": "导入单词到墨墨云词本，支持 MiniMax CN AI 分析词汇、短语和例句",
  "author": "Chris Curry <hichriscurry@gmail.com>",
  "homepage": "https://github.com/Rowan-rh/bob-plugin-maimemo-notebook",
  "appcast": "https://raw.githubusercontent.com/Rowan-rh/bob-plugin-maimemo-notebook/codex/maimemo-customization/appcast.json",
  "minBobVersion": "0.5.0",
  "options": [
    {
      "identifier": "maimemoToken",
      "type": "text",
      "title": "墨墨开放 API Token",
      "desc": "请填写墨墨开放 API Token，获取方式请参考 https://open.maimemo.com/",
      "textConfig": {
        "type": "secure"
      }
    },
    {
      "identifier": "notepadId",
      "type": "text",
      "title": "墨墨云词本 ID",
      "desc": "请前往 https://open.maimemo.com/#/operations/maimemo.openapi.notepad.v1.NotepadService.ListNotepads 查询已有云词本。如果不填，则默认创建一个新词本",
      "textConfig": {
        "type": "secure"
      }
    },
    {
      "identifier": "canAddSentence",
      "type": "menu",
      "title": "添加例句到生词",
      "desc": "如果需要支持添加例句到选定生词，请打开此项",
      "menuValues": [
        {
          "value": "true",
          "title": "是",
          "defaultPluginName": "墨墨云词本（例句）"
        },
        {
          "value": "false",
          "title": "否",
          "defaultPluginName": "墨墨云词本"
        }
      ],
      "defaultValue": "false",
      "isKeyOption": true
    },
    {
      "identifier": "openaiApiKey",
      "type": "text",
      "title": "OpenAI API 密钥",
      "desc": "可前往 https://platform.openai.com/api-keys 查询已有 API 密钥。MiniMax CN Token 优先级高于 OpenAI；未配置 MiniMax CN 时，OpenAI 优先于智谱"
    },
    {
      "identifier": "openaiModel",
      "type": "menu",
      "title": "OpenAI 模型",
      "menuValues": [
        {
          "value": "gpt-4.1-mini",
          "title": "GPT-4.1 mini"
        },
        {
          "value": "gpt-4.1",
          "title": "GPT-4.1"
        }
      ],
      "defaultValue": "gpt-4.1-mini"
    },
    {
      "identifier": "bigModelApiKey",
      "type": "text",
      "title": "智谱 API 密钥",
      "desc": "当 MiniMax CN 和 OpenAI 密钥都未配置时使用"
    },
    {
      "identifier": "bigModelModel",
      "type": "menu",
      "title": "智谱语言模型",
      "defaultValue": "GLM-4-Flash",
      "menuValues": [
        {
          "title": "高智能旗舰[GLM-4-Plus]",
          "value": "GLM-4-Plus"
        },
        {
          "title": "超长输入[GLM-4-Long]",
          "value": "GLM-4-Long"
        },
        {
          "title": "极速推理[GLM-4-AirX]",
          "value": "GLM-4-AirX"
        },
        {
          "title": "高性价比[GLM-4-Air]",
          "value": "GLM-4-Air"
        },
        {
          "title": "免费调用[GLM-4-Flash]",
          "value": "GLM-4-Flash"
        },
        {
          "title": "高速低价[GLM-4-FlashX]",
          "value": "GLM-4-FlashX"
        },
        {
          "title": "Agent模型[GLM-4-AllTools]",
          "value": "GLM-4-AllTools"
        },
        {
          "title": "旧版旗舰[GLM-4]",
          "value": "GLM-4"
        }
      ]
    },
    {
      "identifier": "miniMaxCNApiKey",
      "type": "text",
      "title": "MiniMax CN API Token",
      "desc": "填写 MiniMax 国内版开放平台的 API Key。配置后，英文输入会由 AI 自动整理单词和短语，并生成未收录词条的记忆内容。",
      "textConfig": {
        "type": "secure"
      }
    },
    {
      "identifier": "miniMaxCNModel",
      "type": "menu",
      "title": "MiniMax CN 模型",
      "desc": "仅在配置 MiniMax CN API Token 后使用",
      "defaultValue": "MiniMax-M3",
      "menuValues": [
        {
          "title": "MiniMax M3",
          "value": "MiniMax-M3"
        },
        {
          "title": "MiniMax M2.7",
          "value": "MiniMax-M2.7"
        },
        {
          "title": "MiniMax M2.7 高速",
          "value": "MiniMax-M2.7-highspeed"
        },
        {
          "title": "MiniMax M2.5",
          "value": "MiniMax-M2.5"
        },
        {
          "title": "MiniMax M2.5 高速",
          "value": "MiniMax-M2.5-highspeed"
        },
        {
          "title": "MiniMax M2.1",
          "value": "MiniMax-M2.1"
        },
        {
          "title": "MiniMax M2.1 高速",
          "value": "MiniMax-M2.1-highspeed"
        },
        {
          "title": "MiniMax M2",
          "value": "MiniMax-M2"
        }
      ]
    }
  ]
}
